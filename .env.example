# ==============================================================================
# David888 Bento Portfolio - 全域環境變數設定範例 (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 前端環境變數 (Vite / Browser - VITE_ 開頭會注入前端客戶端)
# ------------------------------------------------------------------------------

# Cloudflare Turnstile 網站金鑰 (Sitekey, 用於前端渲染驗證框)
# 於 Cloudflare Dashboard -> Turnstile 取得
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Firebase Web App API Key (公開於客戶端，供 Firestore 與 Functions 呼叫)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# (選填) 自訂 Contact API 路徑 (預設: /api/contact)
# VITE_CONTACT_API_URL=/api/contact

# (選填) Gemini API Key (用於特定 AI 工具功能)
# GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 2. Vercel Serverless / 寄件服務 (後端環境變數 - 請於 Vercel Dashboard 設定)
# ------------------------------------------------------------------------------

# Resend API Key (於 https://resend.com/api-keys 取得，格式如 re_xxxxxxxxxxxx)
RESEND_API_KEY=re_your_resend_api_key

# 管理員通知收件信箱 (預設: 104@david888.com)
ADMIN_EMAIL=104@david888.com

# 寄件者顯示名稱與地址 (未綁定網域前使用 Resend 沙盒: onboarding@resend.dev)
# 網域驗證後可設定為: David888 Portfolio <contact@david888.com>
RESEND_FROM=David888 Portfolio <onboarding@resend.dev>

# Cloudflare Turnstile 密鑰 (Secret Key，供後端向 Cloudflare 進行 siteverify 驗證)
TURNSTILE_SECRET=0x4AAAAAA...your_turnstile_secret

# ------------------------------------------------------------------------------
# 3. Firebase Cloud Functions 密鑰 (備援通道 - 使用 Firebase Secret Manager)
# ------------------------------------------------------------------------------
# 設定指令: firebase functions:secrets:set KEY_NAME --project aicreate360-official-web-stg
#
# RESEND_API_KEY=re_your_resend_api_key
# TURNSTILE_SECRET=0x4AAAAAA...your_turnstile_secret
# SMTP_USER=104@david888.com
# SMTP_PASS=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=104@david888.com
